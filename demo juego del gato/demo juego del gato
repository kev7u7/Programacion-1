import tkinter as tk
from tkinter import messagebox
import numpy as np

#---------------------------------------------
def hay_ganador(tablero, jugador):
    for i in range(3):
        if np.all(tablero[i, :] == jugador):
            return True
        if np.all(tablero[:, i] == jugador):
            return True
    if np.all(np.diag(tablero) == jugador):
        return True
    if np.all(np.diag(np.fliplr(tablero)) == jugador):
        return True
    return False
#---------------------------------------------
def jugar(fila, columna):
    global jugador

    if tablero[fila, columna] != " ":   # casilla ocupada: no hacer nada
        return

    tablero[fila, columna] = jugador
    botones[fila][columna].config(text=jugador)

    if hay_ganador(tablero, jugador):
        messagebox.showinfo("Fin del juego", f"¡Ganó el jugador {jugador}!")
        reiniciar()
        return

    if np.all(tablero != " "):
        messagebox.showinfo("Fin del juego", "¡Empate!")
        reiniciar()
        return

    jugador = "O" if jugador == "X" else "X"
    etiqueta.config(text=f"Turno: {jugador}")
#---------------------------------------------
def reiniciar():
    global jugador
    tablero[:] = " "
    jugador = "X"
    for fila in botones:
        for boton in fila:
            boton.config(text=" ")
    etiqueta.config(text="Turno: X")
#----------------------------------------------------
# Proceso principal
#----------------------------------------------------
tablero = np.full((3, 3), " ")
jugador = "X"

ventana = tk.Tk()
ventana.title("Juego del gato")

etiqueta = tk.Label(ventana, text="Turno: X", font=("Arial", 14))
etiqueta.grid(row=0, column=0, columnspan=3, pady=5)

botones = []
for f in range(3):
    fila_botones = []
    for c in range(3):
        boton = tk.Button(ventana, text=" ", width=6, height=3,
                          font=("Arial", 20),
                          command=lambda f=f, c=c: jugar(f, c))
        boton.grid(row=f + 1, column=c)
        fila_botones.append(boton)
    botones.append(fila_botones)

ventana.mainloop()